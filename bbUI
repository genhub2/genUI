local function normalizeUrl(u)
    if type(u) ~= "string" then return nil end
    u = u:gsub("^%s+", ""):gsub("%s+$", "")
    if u == "" or u:find("PASTE_") then return nil end
    local raw = u
    if not u:match("^https?://") then
        local ok, dec = pcall(base64decode, u)
        if ok and type(dec) == "string" and dec:match("^https?://") then raw = dec end
    end
    local user, repo, rest = raw:match("^https?://github%.com/([^/]+)/([^/]+)/blob/(.+)$")
    if user then
        return "https://raw.githubusercontent.com/" .. user .. "/" .. repo .. "/" .. rest
    end
    if raw:match("^https?://") then return raw end
    return nil
end

local function cleanup()
    running = false
    for i = 1, #allDrawings do
        pcall(function() allDrawings[i].Visible = false end)
    end
    task.wait(0.05)
    for i = 1, #allDrawings do
        pcall(function() allDrawings[i]:Remove() end)
    end
end

local flashUntil = 0
local function flash(msg)
    status.Color = C_ERROR
    status.Text = msg
    flashUntil = tick() + 3
end

local chosen = nil
local loading = false
local started = tick()
local lastFrame = started
local dotsT = 0
local loadStart = 0
local pendingMode = nil
local pendingUrl = nil
local fetching = false

while not chosen do
    local now = tick()
    local dt = math.min(now - lastFrame, 0.1)
    lastFrame = now

    local age = now - started
    local pin = easeOut(math.min(age / 0.28, 1))
    local hin = easeOut(math.min(math.max(age - 0.10, 0) / 0.30, 1))
    local fin = easeOut(math.min(math.max(age - 0.45, 0) / 0.30, 1))

    local mx, my = currentMouse()
    local m1 = ismouse1pressed()

    backdrop.Transparency = math.min(age / 0.25, 1)

    for i = 1, #dust do
        local p = dust[i]
        p.wobble = p.wobble + dt * 0.8
        p.y = p.y + p.vy * dt
        p.x = p.x + math.sin(p.wobble) * 4 * dt
        if p.y < -6 then
            p.y = sy + 6
            p.x = math.random() * sx
        end
        local dx = p.x - mx
        local dy = p.y - my
        local dist2 = dx * dx + dy * dy
        if dist2 < 6400 and dist2 > 1 then
            local dist = math.sqrt(dist2)
            local f = (1 - dist / 80) * dt * 220
            p.x = p.x + dx / dist * f
            p.y = p.y + dy / dist * f
        end
        p.d.Position = Vector2.new(p.x, p.y)
        p.d.Transparency = p.base * pin
    end

    panel.Transparency = pin
    border.Transparency = 0.08 * pin
    topLine.Transparency = 0.10 * pin

    local sp = (now * 0.28) % 1
    local se = math.sin(sp * math.pi)
    sweep.Position = Vector2.new(PANEL_X + sp * (PANEL_W - 20), PANEL_Y)
    sweep.Size = Vector2.new(20 + se * 26, 2)
    sweep.Transparency = se * 0.7 * pin

    headMark.Transparency = (0.6 + 0.4 * (0.5 + 0.5 * math.sin(now * 3.2))) * pin
    title.Transparency = hin
    subtitle.Transparency = hin
    headLine.Transparency = 0.08 * hin

    local loadP = loading and math.min((now - loadStart) / LOAD_DELAY, 1) or 0
    loadTrack.Transparency = (loading and 0.08 or 0) * fin
    loadFill.Transparency = (loading and 0.5 or 0) * fin
    loadFill.Size = Vector2.new((PANEL_W - 40) * loadP, 2)

    if not loading and tick() > flashUntil then
        status.Text = ""
    end

    if loading then
        dotsT = dotsT + dt
        local n = math.floor(dotsT * 3) % 4
        status.Text = status.Text:gsub("%.+$", "") .. string.rep(".", n)
    end

    local hover = nil
    for i = 1, #rows do
        local r = rows[i]
        local over = (not loading) and inRect(mx, my, r.x, r.y, r.w, r.h)
        if over then hover = r end

        local rin = easeOut(math.min(math.max(age - 0.22 - i * 0.06, 0) / 0.34, 1))
        local target = over and 1 or 0
        r.t = lerp(r.t, target, math.min(dt * 14, 1))
        local t = r.t

        r.fill.Transparency = t * 0.06 * rin
        r.stripe.Transparency = t * rin
        r.arrow.Transparency = t * rin
        r.arrow.Position = Vector2.new(PANEL_X + 36 + (t - 1) * 6, r.y + 10)
        r.num.Transparency = rin
        if r.marker then r.marker.Transparency = (0.35 + 0.35 * (0.5 + 0.5 * math.sin(now * 3))) * rin end
        r.label.Transparency = rin
        r.desc.Transparency = rin
        r.tag.Transparency = rin
        r.tagBox.Transparency = (0.14 + t * 0.5) * rin
        if r.divider then r.divider.Transparency = 0.07 * rin end

        r.num.Color = lerpColor(C_MUTED, C_TEXT, t)
        r.label.Color = lerpColor(C_SUB, C_TEXT, t)
        r.desc.Color = lerpColor(C_MUTED, C_SUB, t)
        r.tag.Color = lerpColor(C_MUTED, C_TEXT, t)
        r.label.Position = Vector2.new(PANEL_X + 60 + t * 2, r.y + 10)
        r.desc.Position = Vector2.new(PANEL_X + 60 + t * 2, r.y + 33)

        if over and not r.hoverPrev then r.sheenT = now end
        r.hoverPrev = over
        if r.sheenT then
            local p = (now - r.sheenT) / 0.55
            if p >= 1 then
                r.sheen.Transparency = 0
                r.sheenT = nil
            else
                r.sheen.Position = Vector2.new(r.x - 36 + p * (PANEL_W + 36), r.y)
                r.sheen.Transparency = (1 - p) * (1 - p) * 0.1 * rin
            end
        else
            r.sheen.Transparency = 0
        end
    end

    footLine.Transparency = 0.08 * fin
    status.Transparency = fin
    hint.Transparency = fin

    local exitHover = (not loading) and inRect(mx, my, EXIT_X, EXIT_Y, EXIT_W, EXIT_H)
    hint.Text = (hover and hover.tip) or "ESC  -  close"
    hint.Color = exitHover and C_TEXT or (hover and C_SUB or C_MUTED)

    if m1 and exitHover and not loading then
        cleanup()
        return
    end

    if m1 and hover and not loading then
        local url = normalizeUrl(GITHUB_URLS[hover.mode])
        if not url then
            flash("Set the " .. tostring(hover.mode) .. " URL in GITHUB_URLS")
        else
            loading = true
            fetching = false
            pendingMode = hover.mode
            pendingUrl = url
            loadStart = tick()
            dotsT = 0
            status.Color = C_SUB
            status.Text = "Preparing " .. hover.mode
            loadFill.Size = Vector2.new(0, 2)
        end
    end

    if loading and not fetching and pendingUrl and now - loadStart >= LOAD_DELAY then
        fetching = true
        status.Text = "Fetching " .. pendingMode
        local ok, body = pcall(function() return httpget(pendingUrl) end)
        if ok and type(body) == "string" and #body > 64 then
            chosen = pendingMode
            status.Color = C_TEXT
            status.Text = "Loading " .. chosen
            pcall(writefile, "loadmode.txt", chosen)
            _G._loadMode = chosen
            task.wait(0.12)
            cleanup()
            local fn, err = loadstring(body)
            if fn then
                local ran, runErr = pcall(fn)
                if not ran then
                    pcall(notify, "gennegen", "Load error: " .. tostring(runErr), 4)
                end
            else
                pcall(notify, "gennegen", "Compile error: " .. tostring(err), 4)
            end
        else
            loading = false
            fetching = false
            pendingUrl = nil
            flash("Failed to fetch. Check the URL and try again.")
        end
    end

    if iskeypressed(27) then
        cleanup()
        return
    end

    task.wait()
end
