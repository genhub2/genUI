local function newDrawing(kind)
    local d = Drawing.new(kind)
    allDrawings[#allDrawings + 1] = d
    return d
end

local function lerp(a, b, t) return a + (b - a) * t end

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

local function newText(txt, font, size, color, z)
    local d = newDrawing("Text")
    d.Text = txt
    d.Font = font
    d.Size = size
    d.Color = color
    pcall(function() d.Outline = true end)
    pcall(function() d.OutlineColor = Color3.fromRGB(0, 0, 0) end)
    d.ZIndex = z
    d.Visible = true
    return d
end

local function newOutline(x, y, w, h, z)
    local dark = newDrawing("Square")
    dark.Filled = false
    dark.Color = Color3.fromRGB(0, 0, 0)
    dark.Thickness = 3
    dark.Size = Vector2.new(w + 2, h + 2)
    dark.Position = Vector2.new(x - 1, y - 1)
    dark.ZIndex = z
    dark.Visible = true

    local light = newDrawing("Square")
    light.Filled = false
    light.Color = COL_IDLE
    light.Thickness = 1
    light.Size = Vector2.new(w, h)
    light.Position = Vector2.new(x, y)
    light.ZIndex = z + 1
    light.Visible = true

    return { dark = dark, light = light }
end

local SNOW = 600
local snow = {}
for i = 1, SNOW do
    local depth = math.random()
    local c = newDrawing("Circle")
    c.Filled = true
    c.Radius = 1 + depth * 2.2
    c.NumSides = 16
    c.Color = Color3.fromRGB(255, 255, 255)
    c.Transparency = 0.25 + depth * 0.5
    c.ZIndex = 1
    local px = math.random() * sx
    local py = math.random() * sy
    c.Position = Vector2.new(px, py)
    c.Visible = true
    snow[i] = {
        d = c, x = px, y = py,
        speed = 12 + depth * 48,
        drift = (math.random() - 0.5) * 14,
        wobble = math.random() * math.pi * 2,
    }
end


local snowLast = tick()
local function updateSnow(mx, my)
    local now = tick()
    local dt = math.min(now - snowLast, 0.1)
    snowLast = now
    local gt = now / GLOW_PERIOD
    for i = 1, #snow do
        local s = snow[i]
        s.wobble = s.wobble + dt * 1.6
        s.y = s.y + s.speed * dt
        s.x = s.x + (s.drift + math.sin(s.wobble) * 6) * dt
        if s.y > sy + 8 then
            s.y = -8
            s.x = math.random() * sx
        end
        if s.x < -8 then s.x = sx + 8 elseif s.x > sx + 8 then s.x = -8 end

        do
            local cx = s.x - mx
            local cy = s.y - my
            local d = math.sqrt(cx * cx + cy * cy)
            if d > 0.001 and d < 95 then
                local force = (1 - d / 95) * dt * 1440
                force = math.min(force, 12)
                s.x = s.x + (cx / d) * force
                s.y = s.y + (cy / d) * force
            end
        end

        for j = 1, #streaks do
            local st = streaks[j]
            local cx = s.x - st.x
            local cy = s.y - st.y
            local d = math.sqrt(cx * cx + cy * cy)
            if d > 0.001 then
                local fall = 1 - (now - st.t) / STREAK_LIFE
                if fall > 0 and d < 80 then
                    local force = (fall * (1 - d / 80)) * dt * 1200
                    force = math.min(force, 12)
                    s.x = s.x + (cx / d) * force
                    s.y = s.y + (cy / d) * force
                end
            end
        end

        do
            local rx = s.x - CX
            local ry = s.y - CY
            local radial = math.sqrt(rx * rx + ry * ry)
            local outside = radial - PLANET_R
            if outside >= 0 then
                for r = 1, GLOW_RINGS do
                    local phase = (gt + (r - 1) / GLOW_RINGS) % 1
                    local grow = phase * GLOW_REACH
                    if outside >= grow - 10 and outside <= grow + 10 then
                        local len = math.max(1, radial)
                        s.x = s.x + (rx / len) * dt * 420
                        s.y = s.y + (ry / len) * dt * 420
                        break
                    end
                end
            end
        end

        s.d.Position = Vector2.new(s.x, s.y)
    end
end

local glow = {}
for i = 1, GLOW_RINGS do
    local fill = newDrawing("Circle")
    fill.Filled = true
    fill.NumSides = 48
    fill.Color = GLOW_COLOR
    fill.Transparency = 0
    fill.ZIndex = 1
    fill.Position = Vector2.new(CX, CY)
    fill.Radius = PLANET_R
    fill.Visible = true

    local ring = newDrawing("Circle")
    ring.Filled = false
    ring.NumSides = 48
    ring.Color = GLOW_COLOR
    ring.Thickness = 2
    ring.Transparency = 0
    ring.ZIndex = 2
    ring.Position = Vector2.new(CX, CY)
    ring.Radius = PLANET_R
    ring.Visible = true

    glow[i] = { d = ring, f = fill, offset = (i - 1) / GLOW_RINGS }
end

local function updateGlow()
    local t = tick() / GLOW_PERIOD
    for i = 1, #glow do
        local g = glow[i]
        local phase = (t + g.offset) % 1
        local grow = phase * GLOW_REACH
        local fade = (1 - phase)
        fade = fade * fade * fade
        local fadeIn = math.min(phase * 8, 1)

        g.d.Position = Vector2.new(CX, CY)
        g.d.Radius   = PLANET_R + 2 + grow
        g.d.Thickness = 2 + (1 - phase) * 2
        g.d.Transparency = GLOW_STRENGTH * fade * fadeIn

        g.f.Position = Vector2.new(CX, CY)
        g.f.Radius   = PLANET_R + 2 + grow
        g.f.Transparency = GLOW_STRENGTH * fade * fadeIn * 0.25
    end
end

