local function normalizeUrl(u)
    if type(u) ~= "string" then return nil end
    u = u:gsub("^%s+", ""):gsub("%s+$", "")
    if u == "" or u:find("PASTE_") then return nil end
    local raw = u
    if not u:match("^https?://") then
        local ok, dec = pcall(base64decode, u)
        if ok and type(dec) == "string" and dec:match("^https?://") then raw = dec end
    end
    local user, repo, rest = raw:match("^https?://github%.com/([^/]+)/([^/]+)/blob/(.+)$")
    if user then
        return "https://raw.githubusercontent.com/" .. user .. "/" .. repo .. "/" .. rest
    end
    if raw:match("^https?://") then return raw end
    return nil
end

local function cleanup()
    running = false
    for i = 1, #allDrawings do
        pcall(function() allDrawings[i].Visible = false end)
    end
    task.wait(0.05)
    for i = 1, #allDrawings do
        pcall(function() allDrawings[i]:Remove() end)
    end
end

local flashUntil = 0
local function flash(msg)
    status.Color = COL_ERROR
    status.Text = msg
    flashUntil = tick() + 3
end

local chosen = nil
local loading = false
local lastFrame = tick()
local dotsT = 0

while not chosen do
    local now = tick()
    local dt = math.min(now - lastFrame, 0.1)
    lastFrame = now

    local mouse = lp:GetMouse()
    local mx = mouse and mouse.X or 0
    local my = mouse and mouse.Y or 0
    local m1 = ismouse1pressed()

    updateSnow(mx, my)
    updateGlow()

    if not loading and tick() > flashUntil then
        status.Text = ""
    end

    if loading then
        dotsT = dotsT + dt
        local n = math.floor(dotsT * 3) % 4
        status.Text = status.Text:gsub("%.+$", "") .. string.rep(".", n)
    end

    local overPlanet = ((mx - CX)^2 + (my - CY)^2) <= PLANET_R^2

    local hover = nil
    local exitHover = false
    for i = 1, #cards do
        local c = cards[i]
        local over = (not loading) and inRect(mx, my, c.x, c.y, c.w, c.h)
        if over then hover = c end

        local target = over and 1 or 0
        c.t = lerp(c.t, target, math.min(dt * 14, 1))
        local t = c.t
        c.frame.light.Color  = lerpColor(COL_IDLE, ACCENT, t)
        c.frameFill.Transparency = 0.9 + t * 0.08
        c.frame.dark.Thickness = 3 + t
        c.stripe.Color       = lerpColor(COL_IDLE, ACCENT, t)
        c.stripe.Size        = Vector2.new(3 + t * 2, c.h)
        c.num.Color          = lerpColor(COL_MUTED, ACCENT, t)
        c.desc.Color         = lerpColor(COL_MUTED, COL_SUB, t)
        c.label.Position     = Vector2.new(c.textX + t * 3, c.y + 14)
        c.desc.Position      = Vector2.new(c.textX + t * 3, c.y + 36)
        c.pill.light.Color   = lerpColor(COL_IDLE, ACCENT, t)
        c.tag.Color          = lerpColor(COL_SUB, ACCENT, t)
    end

    local ex, ey = mx - exitX, my - exitY
    local exitHover = (ex >= 0 and ex <= exitW and ey >= 0 and ey <= exitH) and not loading
    if exitHover then
        exitFrame.light.Color = ACCENT
        exitFill.Transparency = 0.3
        footer.Color = ACCENT
    else
        exitFrame.light.Color = COL_IDLE
        exitFill.Transparency = 0.14
        footer.Color = COL_MUTED
    end

    if m1 and exitHover and not loading then
        cleanup()
        return
    end
    if m1 and not loading and not hover and not overPlanet then
        local last = streaks[#streaks]
        if not last or math.sqrt((last.x - mx)^2 + (last.y - my)^2) > 2 then
            if last then
                local ln = newDrawing("Line")
                ln.From = Vector2.new(last.x, last.y)
                ln.To = Vector2.new(mx, my)
                ln.Color = ACCENT
                ln.Thickness = 4
                ln.Transparency = 1
                ln.ZIndex = 10
                ln.Visible = true
                streakSegments[#streakSegments + 1] = { d = ln, t = now, fade = 1 }
            end
            streaks[#streaks + 1] = { x = mx, y = my, t = now }
        end
    end

    for i = #streaks, 1, -1 do
        if now - streaks[i].t > STREAK_LIFE then
            table.remove(streaks, i)
        end
    end

    for i = #streakSegments, 1, -1 do
        local seg = streakSegments[i]
        local age = now - seg.t
        if age > STREAK_LIFE then
            pcall(function() seg.d.Visible = false end)
            pcall(function() seg.d:Remove() end)
            table.remove(streakSegments, i)
        else
            local fade = 1 - age / STREAK_LIFE
            seg.d.Transparency = 0.15 + fade * 0.85
            seg.d.Color = lerpColor(COL_SUB, ACCENT, fade)
            seg.d.Thickness = 1 + fade * 2
        end
    end

    if m1 and hover and not loading then
        local url = normalizeUrl(GITHUB_URLS[hover.mode])
        if not url then
            flash("Set the " .. tostring(hover.mode) .. " URL in GITHUB_URLS")
        else
            loading = true
            dotsT = 0
            status.Color = COL_SUB
            status.Text = "Fetching " .. hover.mode
            local ok, body = pcall(function() return httpget(url) end)
            if ok and type(body) == "string" and #body > 64 then
                chosen = hover.mode
                status.Color = COL_TEXT
                status.Text = "Loading " .. chosen
                pcall(writefile, "loadmode.txt", chosen)
                _G._loadMode = chosen
                task.wait(0.12)
                cleanup()
                local fn, err = loadstring(body)
                if fn then
                    local ran, runErr = pcall(fn)
                    if not ran then
                        pcall(notify, "gennegen", "Load error: " .. tostring(runErr), 4)
                    end
                else
                    pcall(notify, "gennegen", "Compile error: " .. tostring(err), 4)
                end
            else
                loading = false
                flash("Failed to fetch. Check the URL and try again.")
            end
        end
    end

    if iskeypressed(27) then
        cleanup()
        return
    end

    task.wait()
end
