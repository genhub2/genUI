local function newDrawing(kind)
    local d = Drawing.new(kind)
    allDrawings[#allDrawings + 1] = d
    return d
end

local function lerp(a, b, t) return a + (b - a) * t end
local function easeOut(p) return 1 - (1 - p) * (1 - p) * (1 - p) end

local function lerpColor(a, b, t)
    return Color3.new(
        a.R + (b.R - a.R) * t,
        a.G + (b.G - a.G) * t,
        a.B + (b.B - a.B) * t
    )
end

local function newText(txt, font, size, color, z)
    local d = newDrawing("Text")
    d.Text = txt
    d.Font = font
    d.Size = size
    d.Color = color
    d.Transparency = 1
    d.ZIndex = z
    d.Visible = true
    return d
end

local function textWidth(d, fallback)
    local ok, bounds = pcall(function() return d.TextBounds end)
    if ok and bounds and bounds.X and bounds.X > 0 then return bounds.X end
    return fallback
end

local function inRect(mx, my, x, y, w, h)
    return mx >= x and mx <= x + w and my >= y and my <= y + h
end

local function currentMouse()
    local ok, pos = pcall(function() return UIS:GetMouseLocation() end)
    if ok and pos then return pos.X, pos.Y end
    local mouse = lp:GetMouse()
    return (mouse and mouse.X or 0), (mouse and mouse.Y or 0)
end

